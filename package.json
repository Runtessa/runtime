{
  "name": "@idp/core",
  "version": "0.1.0",
  "private": true,
  "main": "../../dist/server.js",
  "scripts": {
    "build:shared": "tsc -p ../packages/shared/tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run build:shared && npm run build",
    "test": "npm run test:security && npm run test:tenant-provisioning && npm run test:sso-primitives && npm run test:registry-naming && npm run test:registry-source && npm run test:preview && npm run test:adapter-config && npm run test:kernel-source && npm run test:studio-preview",
    "test:security": "ts-node --transpile-only tests/coreHttpSecurity.test.ts",
    "test:tenant-provisioning": "ts-node --transpile-only tests/tenantProvisioning.test.ts",
    "test:sso-primitives": "ts-node --transpile-only tests/ssoPrimitives.test.ts",
    "test:registry-naming": "ts-node --transpile-only tests/registryNaming.test.ts",
    "test:registry-source": "ts-node --transpile-only tests/registrySource.test.ts",
    "start": "npm run build:all && ts-node server.ts",
    "start:dist": "NODE_PATH=./node_modules node ../../dist/server.js",
    "dev": "npm run start",
    "seed": "ts-node seed.ts",
    "seed-packages": "ts-node seed-packages.ts",
    "db:status": "node ../packages/shared/dist/database/cli.js status --target core",
    "db:plan": "node ../packages/shared/dist/database/cli.js plan --target core",
    "db:diff": "node ../packages/shared/dist/database/cli.js diff --target core",
    "db:migrate": "node ../packages/shared/dist/database/cli.js migrate --target core",
    "db:adopt": "node ../packages/shared/dist/database/cli.js adopt --target core",
    "test:preview": "ts-node --transpile-only tests/devPreviewAccess.test.ts",
    "test:adapter-config": "ts-node --transpile-only tests/adapterConnectionConfig.test.ts",
    "test:kernel-source": "ts-node --transpile-only tests/kernelSourceRuntime.test.ts",
    "test:studio-preview": "ts-node --transpile-only tests/studioPreview.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@idp/shared": "file:../packages/shared",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "esbuild": "0.28.2",
    "express": "4.22.1",
    "ioredis": "5.8.2",
    "kafkajs": "2.2.4",
    "mssql": "12.7.4",
    "mysql2": "3.24.5",
    "pg": "8.16.3",
    "react": "19.2.4",
    "reflect-metadata": "0.1.14",
    "typeorm": "0.3.31",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/http-proxy": "1.17.17",
    "@types/mssql": "9.1.8",
    "@types/node": "20.19.27",
    "@types/pg": "8.16.0",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "ts-node": "10.9.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runtessa/runtime.git"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "overrides": {
    "qs": "6.16.0",
    "uuid": "11.1.1",
    "serialize-javascript": "7.1.2",
    "postcss": "8.5.29",
    "dompurify": "3.4.17",
    "tedious": "20.3.7",
    "@ai-sdk/provider-utils@>=4.0.0 <5.0.0": "4.0.33"
  }
}
