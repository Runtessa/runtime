INSTANCE_NAME=srv-dev
PORT=3005
# PostgreSQL connection (choose either DATABASE_URL or discrete host settings)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/idpcore2
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=idpcore2

# Crypto keys (32-byte values; use base64 or hex)
ENCRYPTION_KEY=replace_with_private_value
TOKEN_SECRET=replace_with_private_value

# Logging
DB_LOGGING=false

MONITORING_SERVER_URL=https://localhost:3011
MONITORING_SERVER_TOKEN=change-me
MONITORING_ENFORCE_TLS=true
AGENT_CONTAINER_MANAGER_URL=
AGENT_CONTAINER_MANAGER_TOKEN=
AGENT_CONTAINER_MANAGER_INSECURE_TLS=false
